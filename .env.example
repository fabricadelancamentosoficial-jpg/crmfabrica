# Copie este arquivo para ".env" (sem o .example) e preencha os valores reais.
# O .env nunca vai pro git (já está no .gitignore).

# Senha de acesso ao CRM
FABRICA_CRM_PASSWORD=fabrica2026

# --- Resumo diário por e-mail ---
# Gmail: ative a verificação em duas etapas na conta e gere uma "senha de app"
# em https://myaccount.google.com/apppasswords — use essa senha aqui, não a normal.
FABRICA_SMTP_HOST=smtp.gmail.com
FABRICA_SMTP_PORT=587
FABRICA_SMTP_USER=seuemail@gmail.com
FABRICA_SMTP_PASSWORD=
FABRICA_DIGEST_TO=arthur@exemplo.com,cris@exemplo.com,amanda@exemplo.com
FABRICA_APP_URL=http://localhost:5050

# Depois de quantos dias sem mudar de etapa um lead é considerado "parado"
FABRICA_STALE_DAYS=7

# --- Agendamento inteligente ---
# Janela de atendimento e duração padrão de cada compromisso — usado pra avisar
# quando um follow-up cai fora do horário ou bate em cima de outro já marcado.
FABRICA_AGENDA_INICIO=09:00
FABRICA_AGENDA_FIM=18:00
FABRICA_AGENDA_DURACAO_MIN=60
FABRICA_AGENDA_DIAS=0,1,2,3,4

# --- Webhook de captura de leads (formulário de aplicação) ---
# Token que você inclui na URL do webhook para impedir que qualquer um crie leads.
# Gere algo aleatório, ex: openssl rand -hex 16
FABRICA_WEBHOOK_SECRET=
